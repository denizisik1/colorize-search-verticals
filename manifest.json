{
  "manifest_version": 2,
  "name": "Google Search Verticals",
  "version": "2.1",

  "description": "Pin Google search tabs in a fixed order, restore omitted verticals, and color each one so Images, Videos, Maps and the rest always look and sit the same.",

  "icons": {
    "48": "icons/48.png",
    "96": "icons/96.png"
  },

  "content_scripts": [
    {
      "matches": [
        "*://www.google.com/*",
        "*://google.com/*",
        "*://www.google.co.uk/*",
        "*://www.google.de/*",
        "*://www.google.fr/*",
        "*://www.google.ca/*",
        "*://www.google.com.au/*",
        "*://www.google.co.jp/*",
        "*://www.google.co.in/*",
        "*://www.google.es/*",
        "*://www.google.it/*",
        "*://www.google.nl/*",
        "*://www.google.pl/*",
        "*://www.google.com.br/*",
        "*://www.google.com.mx/*",
        "*://www.google.com.tr/*",
        "*://www.google.se/*",
        "*://www.google.no/*",
        "*://www.google.fi/*",
        "*://www.google.dk/*",
        "*://www.google.be/*",
        "*://www.google.at/*",
        "*://www.google.ch/*",
        "*://www.google.ie/*",
        "*://www.google.co.il/*",
        "*://www.google.co.kr/*",
        "*://www.google.com.tw/*",
        "*://www.google.com.hk/*",
        "*://www.google.com.sg/*",
        "*://www.google.co.za/*"
      ],
      "css": ["src/css/bar.css", "src/css/colors.css"],
      "js": [
        "src/js/config.js",
        "src/js/urls.js",
        "src/js/identify.js",
        "src/js/items.js",
        "src/js/apply.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
